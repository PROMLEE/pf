# meet_in_the_middle/.env와 같은 프로젝트/로그인 값
DATABASE_URL=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 로컬 QA 관리자 로그인 전용 (NODE_ENV=development 및 localhost에서만 작동)
# LOCAL_ADMIN_USERNAME=
# LOCAL_ADMIN_PASSWORD=
# LOCAL_ADMIN_USER_ID=

# 한국투자증권 Open API 실전 앱 키 (브라우저에 노출하지 않습니다)
KIS_APP_KEY=
KIS_APP_SECRET=

# 기본값: https://openapi.koreainvestment.com:9443
# KIS_BASE_URL=

# 주식 시세 공급자: kis (기본) 또는 toss. 실패한 종목만 보조 공급자로 재조회.
STOCK_DATA_PROVIDER=kis
STOCK_DATA_FALLBACK=true
# 토스증권 WTS에서 발급. 서버의 호출 IP를 토스 허용 IP에 등록해야 합니다.
# NEXT_PUBLIC_ 접두사를 붙이지 마세요.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
